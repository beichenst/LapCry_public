<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LapCry</AssemblyName>
    <RootNamespace>LapCry.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\LapCry.ico</ApplicationIcon>
    <Version>0.0.8</Version>
    <AssemblyVersion>0.0.8.0</AssemblyVersion>
    <FileVersion>0.0.8.0</FileVersion>
    <Authors>Bin9chn</Authors>
    <Company>Bin9chn</Company>
    <Copyright>Copyright 2026 Bin9chn</Copyright>
    <Product>LapCry</Product>
    <Description>Local-first desktop data workbench.</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\build\prod\**\*"
             Exclude="..\..\build\prod\**\*.zip;..\..\build\prod\**\*.gz;..\..\build\prod\**\*.br;..\..\build\prod\BundleAnalyzerReport.html;..\..\build\prod\sha256digest.txt"
             LogicalName="LapCry.Web.%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\README.md">
      <LogicalName>LapCry.Docs.README.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\LICENSE">
      <LogicalName>LapCry.Docs.LICENSE</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\THIRD_PARTY_NOTICES.md">
      <LogicalName>LapCry.Docs.THIRD_PARTY_NOTICES.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
